apiVersion: v1
kind: Secret
metadata:
  name: owlflow-secrets
  namespace: owlflow
  labels:
    app.kubernetes.io/name: owlflow
type: Opaque
stringData:
  # GitLab API token for merge request / commit checks
  GITLAB_TOKEN: "glpat-your-gitlab-token-here"
  
  # Jira Cloud credentials for comment checks & issue management
  JIRA_USER: "automation@example.com"
  JIRA_TOKEN: "your-jira-api-token-here"
  JIRA_BASE_URL: "https://your-company.atlassian.net"
  
  # Syslog integration (optional)
  SYSLOG_ENABLED: "false"
  SYSLOG_SERVER: "syslog.internal:514"
